# API environment
FAMA_API_ENV=production

# API authentication
FAMA_API_KEY=change_this_to_your_secure_api_key

# Model provider API keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
FORMATION_API_KEY=your_formation_api_key_here

# Default model settings
FAMA_DEFAULT_PROVIDER=openai
FAMA_DEFAULT_MODEL_ID=gpt-4o
FAMA_DEFAULT_TEMPERATURE=0.1

# Server settings
FAMA_HOST=0.0.0.0
FAMA_PORT=8000
FAMA_DOCS_ENABLED=true

# Logging
FAMA_LOG_LEVEL=INFO

# CORS Settings 
FAMA_CORS_ORIGIN_LIST=https://yourdomain.com,https://api.yourdomain.com

# Database configuration
POSTGRES_USER=fama_user
POSTGRES_PASSWORD=change_this_to_a_secure_password
POSTGRES_DB=fama
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Connection string (constructed from above params)
# This is used directly by the API for connecting to the database
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Rate limiting
FAMA_RATE_LIMIT_PER_MINUTE=60

# Security settings
FAMA_REQUEST_TIMEOUT=300
FAMA_MAX_REQUEST_SIZE=10485760

# Storage settings
FAMA_UPLOADS_DIR=/app/uploads

# Optional: LanceDB storage location if using filesystem storage
LANCEDB_URI=/app/data/lancedb 