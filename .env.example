# Financial Modeling Agent API Environment Variables

# Model Provider Settings
LLM_PROVIDER=formation
LLM_MODEL_ID=best-quality

# API Keys for Model Providers
FORMATION_API_KEY=your_formation_api_key_here
FORMATION_API_BASE_URL=https://agents.formation.cloud/v1

# Alternative Model Providers (uncomment and fill as needed)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# MISTRAL_API_KEY=your_mistral_api_key_here
# TOGETHER_API_KEY=your_together_api_key_here
# COHERE_API_KEY=your_cohere_api_key_here

# Plaid API Settings (for financial data integration)
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here

# API Security
API_SECRET_KEY=your_api_secret_key_here

# Server Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development # development or production 