# Server settings
HOST=0.0.0.0
PORT=8000

# API Documentation
DOCS_ENABLED=true

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Local development database (optional)
POSTGRES_USER=fama_user
POSTGRES_PASSWORD=strong_password_here
POSTGRES_DB=fama

# Storage paths
UPLOADS_DIR=/app/uploads
LOGS_DIR=/app/logs
DATA_DIR=/app/data

# Note: API keys, storage connections, and other configuration
# parameters are provided by API callers in their request payloads,
# not as environment variables to the server. 