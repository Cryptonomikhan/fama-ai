# API environment (development, production)
API_ENV=development

# Valid API keys for development (comma-separated)
VALID_API_KEYS=test_key,another_test_key

# Formation API base URL (optional)
# FORMATION_API_BASE_URL=https://api.formation.ai/v1 

# API Key for authenticating clients
# Required for API authentication
API_KEY=test_key

# Default model provider to use if not specified in the request
# Options: formation, openai, anthropic
MODEL_PROVIDER=formation

# Default model ID to use with the selected provider
MODEL_ID=best-reasoning

# Logging level
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Demonstration mode for synchronous processing
# Set to 1 to enable, leave blank to disable
DEMO_MODE=1

# Server host and port
HOST=0.0.0.0
PORT=8000
